<Window x:Class="ExplorerManager.Desktop.LockAlertWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="File in use" Style="{StaticResource {x:Type Window}}" Width="720" SizeToContent="Height" MinHeight="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <StackPanel Margin="28">
  <Border Style="{StaticResource Badge}" Background="{StaticResource DangerSoftBrush}" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="File in use" Foreground="{StaticResource WarningBrush}" FontSize="12"/></Border>
  <TextBlock Text="사용 중인 파일을 건너뛰었습니다" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <TextBlock Text="파일을 사용하는 앱과 경로를 확인한 후 작업을 선택하세요." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
  <Border Style="{StaticResource Card}" Padding="16"><ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></ScrollViewer></Border>
  <TextBlock Text="강제 종료 후 삭제하시겠습니까?" FontWeight="SemiBold" FontSize="16" Margin="0,24,0,8"/>
  <TextBlock Text="앱을 종료하면 저장하지 않은 작업이 사라질 수 있습니다. 실행 전에 대상 앱과 파일을 다시 확인합니다." TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="12"/>
  <WrapPanel Margin="0,24,0,0"><Button Content="Skip" Command="{Binding Skip}" IsDefault="True" IsCancel="True" Margin="0,0,8,0"/><Button Content="Retry" Command="{Binding Retry}" Margin="0,0,8,0"/><Button Content="정상 종료 요청" Command="{Binding NormalClose}" Margin="0,0,8,0"/><Button Content="강제 종료 후 삭제" Command="{Binding ForceClose}" Style="{StaticResource DangerButton}"/></WrapPanel>
 </StackPanel>
</Window>
