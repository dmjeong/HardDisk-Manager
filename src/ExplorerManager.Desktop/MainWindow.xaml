<Window x:Class="ExplorerManager.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ExplorerManager.Desktop"
 Title="Explorer Manager" Style="{StaticResource {x:Type Window}}" Width="1440" Height="920" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Left"><TextBlock Text="EXPLORER MANAGER" FontSize="27" FontWeight="Bold"/><TextBlock Text="드라이브 정리와 복구 · Windows Service" Foreground="#90A8C1" Margin="0,4,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="관리자 실행" Command="{Binding ElevateCommand}"/>
    <Button Content="새로 고침" Command="{Binding RefreshCommand}"/>
    <Button Content="전체 일시정지" Command="{Binding PauseCommand}" Style="{StaticResource DangerButton}"/>
    <Button Content="재개" Command="{Binding ResumeCommand}"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#172A40" CornerRadius="7" Padding="13" Margin="0,0,0,12">
   <DockPanel><TextBlock Text="{Binding CacheText, StringFormat=복구 캐시  {0}}" DockPanel.Dock="Right"/><TextBlock Text="{Binding Status}"/></DockPanel>
  </Border>
  <TabControl x:Name="Sections" Grid.Row="2">
   <TabItem Header="대시보드">
    <Grid><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DataGrid ItemsSource="{Binding Volumes}"><DataGrid.Columns>
      <DataGridTextColumn Header="드라이브" Binding="{Binding Mount}" Width="100"/><DataGridTextColumn Header="이름" Binding="{Binding Label}" Width="*"/>
      <DataGridTextColumn Header="사용률 %" Binding="{Binding UsedPercent,StringFormat=F1}" Width="110"/><DataGridTextColumn Header="여유 바이트" Binding="{Binding FreeBytes,StringFormat=N0}" Width="170"/>
      <DataGridTextColumn Header="파일 시스템" Binding="{Binding FileSystem}" Width="120"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="180"/>
     </DataGrid.Columns></DataGrid>
     <GroupBox Grid.Row="1" Header="CPU 사용률 · 최근 120개 표본"><local:Sparkline Values="{Binding CpuSeries}" /></GroupBox>
     <DockPanel Grid.Row="2" Margin="0,12,0,8"><TextBlock Text="정리 실행 이력" FontSize="17" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="현재 작업 취소" Command="{Binding CancelCommand}" HorizontalAlignment="Right"/></DockPanel>
     <DataGrid Grid.Row="3" ItemsSource="{Binding Runs}"><DataGrid.Columns>
      <DataGridTextColumn Header="시작 UTC" Binding="{Binding StartedUtc,StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/><DataGridTextColumn Header="정책" Binding="{Binding PolicyName}" Width="140"/>
      <DataGridCheckBoxColumn Header="미리보기" Binding="{Binding DryRun}" Width="70"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="170"/>
      <DataGridTextColumn Header="후보" Binding="{Binding Candidates}" Width="70"/><DataGridTextColumn Header="파일/폴더 삭제" Binding="{Binding DeletedFiles}" Width="100"/>
      <DataGridTextColumn Header="폴더 수" Binding="{Binding DeletedDirectories}" Width="70"/><DataGridTextColumn Header="삭제 바이트" Binding="{Binding DeletedBytes,StringFormat=N0}" Width="130"/>
      <DataGridTextColumn Header="여유 공간 순변화" Binding="{Binding ObservedFreeDelta,StringFormat=N0}" Width="140"/><DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="*"/>
     </DataGrid.Columns></DataGrid>
    </Grid>
   </TabItem>
   <TabItem Header="드라이브 정책">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,14,0"><Button Content="+ 새 정책" Command="{Binding NewCommand}" DockPanel.Dock="Top"/>
      <ListBox ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy}" DisplayMemberPath="Name" Background="#172A40" Foreground="White" Padding="8"/>
     </DockPanel>
     <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
       <Button Content="정책 저장" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="미리보기" Command="{Binding PreviewCommand}"/>
       <Button Content="지금 정리" Command="{Binding RunCommand}"/><Button Content="정책 삭제" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock Text="저장 → 미리보기 → 자동 삭제 활성화" FontSize="18" FontWeight="Bold" Margin="4,0,0,12"/>
       <TextBlock Text="사용량 기준은 볼륨 전체에 적용하고, 삭제는 등록한 폴더 내부로 제한합니다." Foreground="#A4BAD0" Margin="4,0,0,8"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="정책 이름"/><TextBox Text="{Binding SelectedPolicy.Name,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="볼륨"/><ComboBox ItemsSource="{Binding Volumes}" DisplayMemberPath="Summary" SelectedValuePath="Id" SelectedValue="{Binding SelectedPolicy.VolumeId}"/></StackPanel>
       </Grid>
       <TextBlock Text="관리 루트 · 한 줄에 한 경로" Margin="3,12,0,0"/><Button Content="폴더 추가…" Command="{Binding AddRootCommand}" HorizontalAlignment="Left"/>
       <TextBox Text="{Binding SelectedPolicy.Roots,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="88" VerticalScrollBarVisibility="Auto"/>
       <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="용량 기준"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedPolicy.Mode}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="시작값 (% 또는 bytes)"/><TextBox Text="{Binding SelectedPolicy.Start,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="종료값 (% 또는 bytes)"/><TextBox Text="{Binding SelectedPolicy.Stop,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="보관 기간 (일)"/><TextBox Text="{Binding SelectedPolicy.RetentionDays,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/></StackPanel>
       </Grid>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="기간 판단 시각"/><ComboBox ItemsSource="{Binding AgeOptions}" SelectedItem="{Binding SelectedPolicy.AgeBasis}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="점검 주기 (초)"/><TextBox Text="{Binding SelectedPolicy.Interval,ValidatesOnExceptions=True}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="재실행 대기 (초)"/><TextBox Text="{Binding SelectedPolicy.Cooldown,ValidatesOnExceptions=True}"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="복구 보호 (시간)"/><TextBox Text="{Binding SelectedPolicy.ProtectionHours,ValidatesOnExceptions=True}"/></StackPanel>
       </Grid>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="1회 삭제 상한 (GiB)"/><TextBox Text="{Binding SelectedPolicy.DeleteLimitGiB,ValidatesOnExceptions=True}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="읽기 상한 (MiB/s)"/><TextBox Text="{Binding SelectedPolicy.ReadMiB,ValidatesOnExceptions=True}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="스캔 제한 (초)"/><TextBox Text="{Binding SelectedPolicy.ScanLimit,ValidatesOnExceptions=True}"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="삭제 제한 (초)"/><TextBox Text="{Binding SelectedPolicy.RunLimit,ValidatesOnExceptions=True}"/></StackPanel>
       </Grid>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="시작 시각 (0~23)"/><TextBox Text="{Binding SelectedPolicy.StartHour,ValidatesOnExceptions=True}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="종료 시각 (1~24)"/><TextBox Text="{Binding SelectedPolicy.EndHour,ValidatesOnExceptions=True}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="1회 처리 항목 상한"/><TextBox Text="{Binding SelectedPolicy.ItemLimit,ValidatesOnExceptions=True}"/></StackPanel>
       </Grid>
       <TextBlock Text="제외 경로 · 한 줄에 한 경로" Margin="3,12,0,0"/><TextBox Text="{Binding SelectedPolicy.Excluded}" AcceptsReturn="True" Height="65"/>
       <TextBlock Text="제외 확장자 · 쉼표로 구분"/><TextBox Text="{Binding SelectedPolicy.Extensions}"/>
       <CheckBox Content="이 정책의 자동 삭제 활성화" IsChecked="{Binding SelectedPolicy.Enabled}"/>
       <TextBlock Text="캐시보다 큰 파일은 건너뜁니다. 링크·특수 속성·최근 파일·복구 보호 대상은 삭제하지 않습니다." Foreground="#A4BAD0" TextWrapping="Wrap" Margin="4"/>
      </StackPanel></ScrollViewer>
     </DockPanel>
    </Grid>
   </TabItem>
   <TabItem Header="삭제 이력">
    <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
     <TextBox Text="{Binding Filter}" Width="350" ToolTip="경로 검색"/><Button Content="검색" Command="{Binding SearchCommand}"/>
     <Button Content="이전" Command="{Binding PreviousCommand}"/><Button Content="다음" Command="{Binding NextCommand}"/>
     <Button Content="현재 목록 CSV" Command="{Binding ExportCommand}"/><TextBlock Text="{Binding HistoryPageText}" Margin="12,0"/>
    </StackPanel>
     <GroupBox DockPanel.Dock="Bottom" Header="폴더별 집계 · 여유 순변화에는 외부 I/O가 포함됩니다." Height="190" Margin="0,12,0,0">
      <DataGrid ItemsSource="{Binding Folders}"><DataGrid.Columns>
       <DataGridTextColumn Header="폴더 경로" Binding="{Binding Path}" Width="*"/>
       <DataGridTextColumn Header="파일 수" Binding="{Binding DeletedFiles}" Width="85"/><DataGridTextColumn Header="폴더 수" Binding="{Binding DeletedDirectories}" Width="85"/>
       <DataGridTextColumn Header="논리 삭제 바이트" Binding="{Binding LogicalBytes,StringFormat=N0}" Width="150"/>
       <DataGridTextColumn Header="여유 순변화" Binding="{Binding ObservedFreeDelta,StringFormat=N0}" Width="150"/>
      </DataGrid.Columns></DataGrid>
     </GroupBox>
     <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedItem}"><DataGrid.Columns>
      <DataGridTextColumn Header="UTC" Binding="{Binding Utc,StringFormat=MM-dd HH:mm:ss}" Width="120"/><DataGridTextColumn Header="종류" Binding="{Binding Kind}" Width="60"/>
      <DataGridTextColumn Header="경로" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="150"/>
      <DataGridTextColumn Header="논리 바이트" Binding="{Binding Bytes,StringFormat=N0}" Width="120"/><DataGridTextColumn Header="복구 상태" Binding="{Binding RecoveryState}" Width="170"/>
      <DataGridTextColumn Header="사유" Binding="{Binding Reason}" Width="240"/>
     </DataGrid.Columns></DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="복구센터">
    <DockPanel><StackPanel DockPanel.Dock="Top">
     <TextBlock Text="최근 삭제본만 보관합니다. FIFO 퇴출·서비스 재시작·전원 종료 시 복구본이 사라집니다." Foreground="#EDC27C" Margin="4,4,4,12"/>
     <StackPanel Orientation="Horizontal"><Button Content="선택 항목 복구" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="다른 폴더로 복구…" Command="{Binding RestoreElsewhereCommand}"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,8,0,12"><TextBox Text="{Binding RecoveryFolder}" Width="540"/><Button Content="폴더 아래 남은 항목 복구" Command="{Binding RestoreFolderCommand}"/></StackPanel>
    </StackPanel>
     <DataGrid ItemsSource="{Binding Recovery}" SelectedItem="{Binding SelectedRecovery}"><DataGrid.Columns>
      <DataGridTextColumn Header="삭제 UTC" Binding="{Binding DeletedUtc,StringFormat=MM-dd HH:mm:ss}" Width="130"/><DataGridTextColumn Header="원래 경로" Binding="{Binding Path}" Width="*"/>
      <DataGridTextColumn Header="바이트" Binding="{Binding Length,StringFormat=N0}" Width="140"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="170"/>
     </DataGrid.Columns></DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="자원 모니터">
    <DockPanel><StackPanel DockPanel.Dock="Top">
     <TextBlock Text="점유 용량은 대시보드, 아래 표는 I/O 부하와 센서 표본입니다. 0 B/s는 유휴일 수 있습니다. 온도 미지원은 상태에 표시됩니다." TextWrapping="Wrap" Margin="4,4,4,14"/>
     <StackPanel Orientation="Horizontal"><TextBlock Text="디스크 장치" Margin="4"/><ComboBox Width="180" ItemsSource="{Binding DiskEntities}" SelectedItem="{Binding SelectedDisk}"/></StackPanel>
     <UniformGrid Columns="3" Height="170" Margin="0,0,0,14">
      <GroupBox Header="읽기 처리량 · MiB/s"><local:Sparkline Values="{Binding ReadSeries}" Maximum="0"/></GroupBox>
      <GroupBox Header="쓰기 처리량 · MiB/s"><local:Sparkline Values="{Binding WriteSeries}" Maximum="0"/></GroupBox>
      <GroupBox Header="읽기/쓰기 최대 지연 · ms"><local:Sparkline Values="{Binding LatencySeries}" Maximum="0"/></GroupBox>
     </UniformGrid>
    </StackPanel>
     <DataGrid ItemsSource="{Binding Metrics}"><DataGrid.Columns>
      <DataGridTextColumn Header="장치" Binding="{Binding Entity}" Width="180"/><DataGridTextColumn Header="항목" Binding="{Binding Name}" Width="180"/>
      <DataGridTextColumn Header="값" Binding="{Binding Display}" Width="140"/><DataGridTextColumn Header="표본 상태" Binding="{Binding Quality}" Width="140"/>
      <DataGridTextColumn Header="출처" Binding="{Binding Provider}" Width="200"/><DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="*"/>
     </DataGrid.Columns></DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="알람센터">
    <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
     <Button Content="확인 처리" Command="{Binding AcknowledgeCommand}"/><Button Content="해당 파일 다시 시도" Command="{Binding RetryCommand}"/>
     <Button Content="정상 종료 요청" Command="{Binding NormalCloseCommand}"/><Button Content="강제 종료 후 삭제…" Command="{Binding ForceCloseCommand}" Style="{StaticResource DangerButton}"/>
    </StackPanel>
     <DataGrid ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}"><DataGrid.Columns>
      <DataGridCheckBoxColumn Header="확인" Binding="{Binding Acknowledged}" Width="55"/><DataGridTextColumn Header="UTC" Binding="{Binding Utc,StringFormat=MM-dd HH:mm:ss}" Width="120"/>
      <DataGridTextColumn Header="등급" Binding="{Binding Severity}" Width="90"/><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="150"/>
      <DataGridTextColumn Header="메시지" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="경로" Binding="{Binding Path}" Width="300"/>
     </DataGrid.Columns></DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="환경설정">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" HorizontalAlignment="Left">
     <TextBlock Text="종료 허용 앱" FontSize="18" FontWeight="Bold" Margin="4,4,4,10"/>
     <TextBlock Text="현재 사용자 세션의 앱 중 아래 실행 파일 이름만 종료할 수 있습니다. 한 줄에 하나씩 입력하세요." TextWrapping="Wrap" Margin="4"/>
     <TextBox Text="{Binding AllowedApps}" Height="100" AcceptsReturn="True"/>
     <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="이력 보관 일수"/><TextBox Text="{Binding Settings.HistoryDays,ValidatesOnExceptions=True}"/>
       <TextBlock Text="CPU 부하 경고 (%)"/><TextBox Text="{Binding Settings.CpuWarningPercent,ValidatesOnExceptions=True}"/>
       <TextBlock Text="CPU 온도 경고 (℃)"/><TextBox Text="{Binding Settings.CpuTemperatureWarning,ValidatesOnExceptions=True}"/>
      </StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="디스크 지연 경고 (ms)"/><TextBox Text="{Binding Settings.DiskLatencyWarningMs,ValidatesOnExceptions=True}"/>
       <TextBlock Text="디스크 온도 경고 (℃)"/><TextBox Text="{Binding Settings.DiskTemperatureWarning,ValidatesOnExceptions=True}"/>
       <TextBlock Text="이상 지속 시간 (초)"/><TextBox Text="{Binding Settings.AnomalyDurationSeconds,ValidatesOnExceptions=True}"/>
      </StackPanel>
     </Grid>
     <CheckBox Content="디스크 심각 알람에서 자동 정리 중단" IsChecked="{Binding Settings.PauseOnHealthCritical}"/>
     <Button Content="환경설정 저장" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
     <TextBlock Text="온도·지연 임계값은 대상 장비 기준으로 조정하세요. 앱 창을 닫으면 트레이로 이동하고 서비스는 계속 동작합니다." TextWrapping="Wrap" Foreground="#A4BAD0" Margin="4,18,4,4"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="3" Padding="10,12,4,0"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#AAC1D8"/></Border>
 </Grid>
</Window>
