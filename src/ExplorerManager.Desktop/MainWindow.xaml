<Window x:Class="ExplorerManager.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ExplorerManager.Desktop"
 xmlns:views="clr-namespace:ExplorerManager.Desktop.Views"
 Title="Explorer Manager" Style="{StaticResource {x:Type Window}}" Width="1440" Height="920" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <DataTemplate x:Key="EnumTemplate"><TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/></DataTemplate>
 </Window.Resources>
 <TabControl x:Name="Sections" Style="{StaticResource SidebarTabs}" SelectedIndex="{Binding SelectedSection,Mode=TwoWay}">
  <TabItem Header="Dashboard" Tag="&#xE80F;" ToolTip="드라이브 상태와 정리 작업을 한눈에 확인하세요.">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <StackPanel>
     <UniformGrid Columns="4" Margin="0,0,-12,24">
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Managed drives" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding VolumeCountText}" Style="{StaticResource MetricNumber}"/><TextBlock Text="등록·감지된 볼륨" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Total free space" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding TotalFreeText}" Style="{StaticResource MetricNumber}"/><TextBlock Text="연결된 볼륨 기준" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Enabled policies" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding EnabledPolicyCountText}" Style="{StaticResource MetricNumber}"/><TextBlock Text="자동 정리 사용 중" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Pending alerts" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding AlertCountText}" Style="{StaticResource MetricNumber}"/><TextBlock Text="확인하지 않은 알림" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,24"><StackPanel>
      <DockPanel><Button Content="Reset interlocks" Command="{Binding ResetInterlocksCommand}" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="Interlocks" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding InterlockSummary}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/></StackPanel></DockPanel>
      <TextBlock Text="{Binding InterlockDetails}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
      <Expander Header="상태별 세부 정보" Margin="0,12,0,0"><DataGrid ItemsSource="{Binding Interlocks}" MaxHeight="240" Margin="0,12,0,0" AutomationProperties.Name="현재 인터록 상태"><DataGrid.Columns>
       <DataGridTextColumn Header="Condition" Binding="{Binding Code,Converter={StaticResource State}}" Width="160"/>
       <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="110"/>
       <DataGridTextColumn Header="State" Binding="{Binding State,Converter={StaticResource State}}" Width="140"/>
       <DataGridCheckBoxColumn Header="Blocking" Binding="{Binding Blocking}" Width="80"/>
       <DataGridCheckBoxColumn Header="Latched" Binding="{Binding Latched}" Width="75"/>
       <DataGridTextColumn Header="Since" Binding="{Binding SinceUtc,Converter={StaticResource LocalTime}}" Width="130"/>
       <DataGridTextColumn Header="Details" Binding="{Binding Detail}" ElementStyle="{StaticResource PathText}" Width="*" MinWidth="150"/>
      </DataGrid.Columns></DataGrid></Expander>
      <TextBlock Text="원인이 남아 있으면 Reset으로 해제되지 않습니다. 수동 Pause는 Resume으로, 디스크 심각 알림은 Alerts에서 별도로 처리하세요." Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/>
     </StackPanel></Border>
     <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Drives" Style="{StaticResource SectionTitle}"/><TextBlock Text="볼륨 전체의 용량을 표시합니다. 삭제 범위는 정책에 등록한 폴더로 제한됩니다." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></DockPanel>
     <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,0,-12,12">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Style="{StaticResource Card}" Margin="0,0,12,12">
        <StackPanel>
         <DockPanel Margin="0,0,0,20"><Border DockPanel.Dock="Right" Style="{StaticResource Badge}"><TextBlock Text="{Binding StateText}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource HoverBrush}" CornerRadius="8" Width="36" Height="36" HorizontalAlignment="Left"><TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding FileSystem}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid></DockPanel>
         <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercentText}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding FreeText,StringFormat=Free: {0}}" FontSize="22" FontWeight="SemiBold"/></DockPanel>
         <ProgressBar Value="{Binding UsedPercent,Mode=OneWay}" Maximum="100" AutomationProperties.Name="드라이브 사용률"/>
         <DockPanel Margin="0,10,0,0"><TextBlock Text="{Binding CapacityText,StringFormat=Total: {0}}" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding UsedText,StringFormat=Used: {0}}" Style="{StaticResource MutedText}" FontSize="11"/></DockPanel>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Border Style="{StaticResource Card}" Visibility="{Binding Volumes.Count,Converter={StaticResource EmptyVisibility}}" Margin="0,0,0,24"><StackPanel><TextBlock Text="드라이브 정보를 기다리고 있습니다" Style="{StaticResource SectionTitle}"/><TextBlock Text="서비스 연결과 드라이브 연결 상태를 확인하세요." Style="{StaticResource MutedText}"/></StackPanel></Border>
     <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="CPU usage" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"/></DockPanel><local:Sparkline Values="{Binding CpuSeries}" Unit="%" Maximum="100" Height="112" Margin="0,10,0,0" AutomationProperties.Name="CPU 사용률 추이"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recovery cache" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CacheSummary}" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,12"/><ProgressBar Value="{Binding CachePercent,Mode=OneWay}" Maximum="100"/><TextBlock Text="최근 삭제본을 RAM에 임시 보관합니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,14,0,0"/><TextBlock Text="서비스 재시작 시 보관본이 사라집니다." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
     </Grid>
     <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="현재 작업 취소" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}"/><StackPanel><TextBlock Text="Recent cleanup" Style="{StaticResource SectionTitle}"/><TextBlock Text="Preview 결과와 실제 삭제 내역을 확인하세요." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></DockPanel>
     <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid>
      <DataGrid ItemsSource="{Binding Runs}" MaxHeight="300">
       <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGrid.RowStyle>
       <DataGrid.Columns>
        <DataGridTextColumn Header="Started" Binding="{Binding StartedUtc,Converter={StaticResource LocalTime}}" Width="130"/>
        <DataGridTextColumn Header="Policy" Binding="{Binding PolicyName}" ElementStyle="{StaticResource PathText}" Width="*" MinWidth="140"/>
        <DataGridCheckBoxColumn Header="Preview" Binding="{Binding DryRun}" Width="86"/>
        <DataGridTextColumn Header="Result" Binding="{Binding State,Converter={StaticResource State}}" Width="132"/>
        <DataGridTemplateColumn Header="Candidates" Width="126"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Candidates,StringFormat={}{0:N0}개}"/><TextBlock Text="{Binding CandidateBytes,Converter={StaticResource Bytes}}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Deleted items" Width="126"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DeletedFiles,StringFormat=파일 {0:N0}개}"/><TextBlock Text="{Binding DeletedDirectories,StringFormat=폴더 {0:N0}개}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Deleted size" Binding="{Binding DeletedBytes,Converter={StaticResource Bytes}}" Width="106"/>
        <DataGridTextColumn Header="Free space Δ" Binding="{Binding ObservedFreeDelta,Converter={StaticResource Bytes}}" Width="112"/>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding Runs.Count,Converter={StaticResource EmptyVisibility}}"><TextBlock Text="아직 정리 작업이 없습니다" HorizontalAlignment="Center"/><TextBlock Text="정책을 저장하고 Preview를 실행하면 이곳에 표시됩니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
     </Grid></Border>
    </StackPanel>
   </ScrollViewer>
  </TabItem>
  <TabItem Header="Policies" Tag="&#xE713;" ToolTip="정리할 폴더와 용량 기준, 보존 기간을 설정하세요.">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="12"><DockPanel>
     <Button DockPanel.Dock="Top" Content="+ New policy" Command="{Binding NewCommand}" Margin="0,0,0,16"/>
     <ListBox ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy}" AutomationProperties.Name="정책 목록"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RetentionDays,StringFormat=보존 기간 {0}일}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel></Border>
    <Grid Grid.Column="2">
     <DockPanel>
      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0"><DockPanel>
       <Button Content="정책 삭제" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" DockPanel.Dock="Left"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="지금 정리" Command="{Binding RunCommand}" Margin="0,0,8,0"/><Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/><Button Content="Save policy" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
      </DockPanel></Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"><StackPanel>
       <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16" Visibility="{Binding SelectedPolicy.HasErrors,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="저장 전에 아래 항목을 수정하세요" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedPolicy.ErrorSummary}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" AutomationProperties.Name="Policy validation errors"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="General" Style="{StaticResource SectionTitle}"/><TextBlock Text="삭제는 아래에 등록한 폴더 안에서만 수행됩니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,20"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Policy name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPolicy.Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Policy name"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Target volume" Style="{StaticResource FieldLabel}"/><ComboBox ToolTip="{Binding SelectedItem.Summary,RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Volumes}" DisplayMemberPath="Summary" SelectedValuePath="Id" SelectedValue="{Binding SelectedPolicy.VolumeId}" AutomationProperties.Name="Target volume"/></StackPanel>
        </Grid>
        <DockPanel Margin="0,18,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Grant access…" Command="{Binding GrantAccessCommand}" Padding="10,5" MinHeight="30" Margin="0,0,8,0"/><Button Content="Add folder…" Command="{Binding AddRootCommand}" Padding="10,5" MinHeight="30"/></StackPanel><TextBlock Text="관리할 폴더" Foreground="{StaticResource MutedBrush}"/></DockPanel>
        <TextBox Text="{Binding SelectedPolicy.Roots,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="관리할 폴더 경로"/>
        <TextBlock Text="한 줄에 한 경로를 입력하세요." Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="Cleanup rules" Style="{StaticResource SectionTitle}"/><TextBlock Text="오래된 대상이 있는 폴더부터 정리하고, 목표 용량 확보 후 진행 중 폴더를 마칩니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,20"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Threshold type" Style="{StaticResource FieldLabel}"/><ComboBox AutomationProperties.Name="Threshold type" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedPolicy.Mode}" ItemTemplate="{StaticResource EnumTemplate}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Start threshold" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="Start threshold" Text="{Binding SelectedPolicy.Start,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/></StackPanel>
         <StackPanel Grid.Column="4"><TextBlock Text="Stop threshold" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="Stop threshold" Text="{Binding SelectedPolicy.Stop,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/></StackPanel>
        </Grid>
        <TextBlock Text="사용률은 %, 사용 용량과 여유 공간은 bytes로 입력하세요." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,18"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Retention (days)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="Retention (days)" Text="{Binding SelectedPolicy.RetentionDays,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="기준 날짜" Style="{StaticResource FieldLabel}"/><ComboBox AutomationProperties.Name="기준 날짜" ItemsSource="{Binding AgeOptions}" SelectedItem="{Binding SelectedPolicy.AgeBasis}" ItemTemplate="{StaticResource EnumTemplate}"/></StackPanel>
        </Grid>
        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="12" Margin="0,18,0,0"><StackPanel><CheckBox Content="자동 정리 활성화" IsChecked="{Binding SelectedPolicy.Enabled}" Margin="0"/><TextBlock Text="먼저 저장한 다음 Preview로 삭제 대상을 확인하세요. 활성화 시 확인 창이 표시됩니다." Style="{StaticResource MutedText}" FontSize="11" Margin="26,7,0,0"/></StackPanel></Border>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="Schedule" Style="{StaticResource SectionTitle}"/><TextBlock Text="실행을 시작할 요일과 로컬 시각을 지정하세요. 자정을 넘는 범위는 선택한 시작 요일을 기준으로 다음 날까지 이어집니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,18"/>
        <WrapPanel><CheckBox Content="Mon" IsChecked="{Binding SelectedPolicy.RunMonday}" Margin="0,0,16,12"/><CheckBox Content="Tue" IsChecked="{Binding SelectedPolicy.RunTuesday}" Margin="0,0,16,12"/><CheckBox Content="Wed" IsChecked="{Binding SelectedPolicy.RunWednesday}" Margin="0,0,16,12"/><CheckBox Content="Thu" IsChecked="{Binding SelectedPolicy.RunThursday}" Margin="0,0,16,12"/><CheckBox Content="Fri" IsChecked="{Binding SelectedPolicy.RunFriday}" Margin="0,0,16,12"/><CheckBox Content="Sat" IsChecked="{Binding SelectedPolicy.RunSaturday}" Margin="0,0,16,12"/><CheckBox Content="Sun" IsChecked="{Binding SelectedPolicy.RunSunday}" Margin="0,0,0,12"/></WrapPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Start time (HH:mm)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPolicy.StartTime,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="실행 시작 시각 HH:mm"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="End time (HH:mm)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPolicy.EndTime,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="실행 종료 시각 HH:mm"/></StackPanel>
        </Grid>
        <TextBlock Text="00:00~24:00은 하루 전체이며 24:00은 종료 시각에만 사용할 수 있습니다. 실행 종료 시각에 도달하면 안전하게 중단합니다." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="Exclusions" Style="{StaticResource SectionTitle}"/><TextBlock Text="삭제하지 않을 경로와 확장자를 지정하세요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,18"/>
        <TextBlock Text="제외 경로 · 한 줄에 한 경로" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="제외 경로 · 한 줄에 한 경로" Text="{Binding SelectedPolicy.Excluded}" AcceptsReturn="True" Height="68" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="제외 확장자 · 쉼표로 구분" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/><TextBox AutomationProperties.Name="제외 확장자 · 쉼표로 구분" Text="{Binding SelectedPolicy.Extensions}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><Expander Header="Advanced · 실행 주기와 안전 제한"><StackPanel Margin="0,18,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="점검 주기 (초)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="점검 주기 (초)" Text="{Binding SelectedPolicy.Interval,ValidatesOnExceptions=True}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="재실행 대기 (초)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="재실행 대기 (초)" Text="{Binding SelectedPolicy.Cooldown,ValidatesOnExceptions=True}"/></StackPanel>
         <StackPanel Grid.Column="4"><TextBlock Text="복구 보호 (시간)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="복구 보호 (시간)" Text="{Binding SelectedPolicy.ProtectionHours,ValidatesOnExceptions=True}"/></StackPanel>
        </Grid>
        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="1회 삭제 상한 (GiB)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="1회 삭제 상한 (GiB)" Text="{Binding SelectedPolicy.DeleteLimitGiB,ValidatesOnExceptions=True}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Read limit (MiB/s)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="Read limit (MiB/s)" Text="{Binding SelectedPolicy.ReadMiB,ValidatesOnExceptions=True}"/></StackPanel>
         <StackPanel Grid.Column="4"><TextBlock Text="처리 항목 상한" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="처리 항목 상한" Text="{Binding SelectedPolicy.ItemLimit,ValidatesOnExceptions=True}"/></StackPanel>
        </Grid>
        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="스캔 제한 (초)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="스캔 제한 (초)" Text="{Binding SelectedPolicy.ScanLimit,ValidatesOnExceptions=True}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="삭제 제한 (초)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="삭제 제한 (초)" Text="{Binding SelectedPolicy.RunLimit,ValidatesOnExceptions=True}"/></StackPanel>
        </Grid>
        <TextBlock Text="캐시보다 큰 파일, 링크, 최근 파일, 복구 보호 대상은 건너뜁니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,18,0,0"/>
       </StackPanel></Expander></Border>
      </StackPanel></ScrollViewer>
     </DockPanel>
     <Border Background="{StaticResource CanvasBrush}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPolicy}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="첫 번째 정리 정책을 만들어보세요" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="대상 폴더와 보존 기간을 지정한 후 Preview로 확인할 수 있습니다." Style="{StaticResource MutedText}" Margin="0,12,0,24"/><Button Content="+ New policy" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/></StackPanel></Border>
    </Grid>
   </Grid>
  </TabItem>
  <TabItem Header="History" Tag="&#xE81C;" ToolTip="삭제 경로, 처리 결과와 확보 공간을 확인하세요.">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="Export CSV" Command="{Binding ExportCommand}"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding Filter}" Width="300" ToolTip="경로를 입력하여 검색" AutomationProperties.Name="삭제 경로 검색"/><Button Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid>
     <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedItem}"><DataGrid.Columns>
      <DataGridTextColumn Header="Time" Binding="{Binding Utc,Converter={StaticResource LocalTime}}" Width="136"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="60"/>
      <DataGridTextColumn Header="Path" Binding="{Binding Path}" ElementStyle="{StaticResource PathText}" Width="*" MinWidth="150"/>
      <DataGridTextColumn Header="Result" Binding="{Binding State,Converter={StaticResource State}}" Width="110"/>
      <DataGridTextColumn Header="Size" Binding="{Binding Bytes,Converter={StaticResource Bytes}}" Width="100"/><DataGridTextColumn Header="Recovery status" Binding="{Binding RecoveryState,Converter={StaticResource State}}" Width="114"/>
      <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" ElementStyle="{StaticResource PathText}" Width="200"/>
     </DataGrid.Columns></DataGrid>
     <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding History.Count,Converter={StaticResource EmptyVisibility}}"><TextBlock Text="표시할 삭제 기록이 없습니다" HorizontalAlignment="Center"/><TextBlock Text="정리 작업을 실행하거나 검색 조건을 변경하세요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
    </Grid></Border>
    <DockPanel Grid.Row="2" Margin="0,14,0,18"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Previous" Command="{Binding PreviousCommand}" Style="{StaticResource GhostButton}"/><Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource GhostButton}"/></StackPanel><TextBlock Text="{Binding HistoryPageText}" Style="{StaticResource MutedText}" FontSize="12"/></DockPanel>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="16,14"><TextBlock Text="Folder summary" Style="{StaticResource SectionTitle}"/><TextBlock Text="여유 공간 순변화에는 같은 시점의 외부 읽기·쓰기도 반영될 수 있습니다." Style="{StaticResource MutedText}" FontSize="11"/></StackPanel><DataGrid ItemsSource="{Binding Folders}" MinHeight="90"><DataGrid.Columns><DataGridTextColumn Header="Folder path" Binding="{Binding Path}" ElementStyle="{StaticResource PathText}" Width="*"/><DataGridTextColumn Header="Files" Binding="{Binding DeletedFiles}" Width="70"/><DataGridTextColumn Header="Folders" Binding="{Binding DeletedDirectories}" Width="70"/><DataGridTextColumn Header="Deleted size" Binding="{Binding LogicalBytes,Converter={StaticResource Bytes}}" Width="120"/><DataGridTextColumn Header="Free space Δ" Binding="{Binding ObservedFreeDelta,Converter={StaticResource Bytes}}" Width="120"/></DataGrid.Columns></DataGrid></DockPanel></Border>
   </Grid>
  </TabItem>
  <TabItem Header="Recovery" Tag="&#xE777;" ToolTip="RAM에 남아 있는 최근 삭제 항목을 복구하세요.">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="최근 삭제본을 잠시 보관합니다" Style="{StaticResource SectionTitle}"/><TextBlock Text="Settings의 RAM 한도 내에서 보관하며 오래된 보관본부터 제거됩니다." Style="{StaticResource MutedText}" Margin="0,5,24,0"/><TextBlock Text="서비스 재시작·전원 종료 후에는 복구할 수 없습니다." Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding CacheSummary}" HorizontalAlignment="Right" FontSize="17" Margin="0,0,0,12"/><ProgressBar Value="{Binding CachePercent,Mode=OneWay}" Maximum="100"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button Content="선택 항목 복구" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="다른 폴더로 복구…" Command="{Binding RestoreElsewhereCommand}" Margin="8,0,0,0"/></StackPanel>
     <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="폴더 내 보관 항목 복구" Command="{Binding RestoreFolderCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding RecoveryFolder}" ToolTip="복구할 원래 폴더 경로" AutomationProperties.Name="복구할 폴더 경로"/></DockPanel>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><DataGrid ItemsSource="{Binding Recovery}" SelectedItem="{Binding SelectedRecovery}"><DataGrid.Columns><DataGridTextColumn Header="Deleted" Binding="{Binding DeletedUtc,Converter={StaticResource LocalTime}}" Width="150"/><DataGridTextColumn Header="Original path" Binding="{Binding Path}" ElementStyle="{StaticResource PathText}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding Length,Converter={StaticResource Bytes}}" Width="120"/><DataGridTextColumn Header="Status" Binding="{Binding State,Converter={StaticResource State}}" Width="140"/></DataGrid.Columns></DataGrid><StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding Recovery.Count,Converter={StaticResource EmptyVisibility}}"><TextBlock Text="복구 가능한 보관본이 없습니다" HorizontalAlignment="Center"/><TextBlock Text="새로 삭제된 항목이 캐시에 보관되면 표시됩니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Grid></Border>
   </Grid>
  </TabItem>
  <TabItem Header="Monitoring" Tag="&#xE9D9;" ToolTip="CPU와 디스크의 사용량, 온도, 응답 지연을 확인하세요.">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"><StackPanel>
    <UniformGrid Columns="4" Margin="0,0,-12,24">
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="CPU usage" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding CpuText}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="CPU temperature" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding CpuTemperatureText}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Disk read" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding ReadRateText}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Disk write" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding WriteRateText}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
    </UniformGrid>
    <DockPanel Margin="0,0,0,14"><ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding DiskEntities}" SelectedItem="{Binding SelectedDisk}" AutomationProperties.Name="모니터링 디스크"/><StackPanel><TextBlock Text="Disk I/O" Style="{StaticResource SectionTitle}"/><TextBlock Text="현재 선택한 디스크 · 최근 120개 표본" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></DockPanel>
    <UniformGrid Columns="3" Margin="0,0,-12,24">
     <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16"><StackPanel><TextBlock Text="Read throughput" Foreground="{StaticResource ChartReadBrush}"/><TextBlock Text="{Binding ReadRateText}" FontSize="19" Margin="0,8,0,8"/><local:Sparkline Values="{Binding ReadSeries}" Maximum="0" Unit="MiB/s" Stroke="{StaticResource ChartReadBrush}" Height="132"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16"><StackPanel><TextBlock Text="Write throughput" Foreground="{StaticResource ChartWriteBrush}"/><TextBlock Text="{Binding WriteRateText}" FontSize="19" Margin="0,8,0,8"/><local:Sparkline Values="{Binding WriteSeries}" Maximum="0" Unit="MiB/s" Stroke="{StaticResource ChartWriteBrush}" Height="132"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16"><StackPanel><TextBlock Text="I/O latency" ToolTip="읽기·쓰기 평균 지연 중 큰 값" Foreground="{StaticResource ChartLatencyBrush}"/><TextBlock Text="{Binding LatencyText}" FontSize="19" Margin="0,8,0,8"/><local:Sparkline Values="{Binding LatencySeries}" Maximum="0" Unit="ms" Stroke="{StaticResource ChartLatencyBrush}" Height="132"/></StackPanel></Border>
    </UniformGrid>
    <TextBlock Text="Sensor details" Style="{StaticResource SectionTitle}"/><TextBlock Text="0 B/s는 유휴 상태일 수 있습니다. 온도 센서가 없거나 권한이 부족하면 미지원·측정 대기로 표시됩니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,14"/>
    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><DataGrid ItemsSource="{Binding Metrics}" Height="300"><DataGrid.Columns><DataGridTextColumn Header="Device" Binding="{Binding Entity}" Width="140"/><DataGridTextColumn Header="Metric" Binding="{Binding Name,Converter={StaticResource MetricName}}" Width="150"/><DataGridTextColumn Header="Value" Binding="{Binding Converter={StaticResource MetricValue}}" Width="140"/><DataGridTextColumn Header="Quality" Binding="{Binding Quality,Converter={StaticResource State}}" Width="110"/><DataGridTextColumn Header="Source" Binding="{Binding Provider}" Width="130"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" ElementStyle="{StaticResource PathText}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding Metrics.Count,Converter={StaticResource EmptyVisibility}}"><TextBlock Text="센서 표본을 기다리고 있습니다" HorizontalAlignment="Center"/><TextBlock Text="서비스와 센서 호스트의 상태를 확인하세요." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Grid></Border>
   </StackPanel></ScrollViewer>
  </TabItem>
  <TabItem Header="Alerts" Tag="&#xE7F4;" ToolTip="잠긴 파일과 디스크 이상 상태를 확인하고 조치하세요.">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><DataGrid ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}"><DataGrid.Columns><DataGridCheckBoxColumn Header="Ack." Binding="{Binding Acknowledged}" Width="55"/><DataGridTextColumn Header="Time" Binding="{Binding Utc,Converter={StaticResource LocalTime}}" Width="140"/><DataGridTextColumn Header="Severity" Binding="{Binding Severity,Converter={StaticResource State}}" Width="75"/><DataGridTextColumn Header="Category" Binding="{Binding Category,Converter={StaticResource State}}" Width="120"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" ElementStyle="{StaticResource PathText}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" ElementStyle="{StaticResource PathText}" Width="240"/></DataGrid.Columns></DataGrid><StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding Alerts.Count,Converter={StaticResource EmptyVisibility}}"><TextBlock Text="등록된 알림이 없습니다" HorizontalAlignment="Center"/><TextBlock Text="파일 잠금과 디스크 이상이 감지되면 여기에 표시됩니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Grid></Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="Selected alert" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SelectedAlert.Message,TargetNullValue=목록에서 알림을 선택하면 상세 내용과 처리 작업을 확인할 수 있습니다.}" TextWrapping="Wrap" Margin="0,8,0,6"/><TextBlock Text="{Binding SelectedAlert.Path}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedAlert.Path}"/>
     <WrapPanel Margin="0,18,0,0"><Button Content="Acknowledge" Command="{Binding AcknowledgeCommand}" Margin="0,0,8,8"/><Button Content="Retry" Command="{Binding RetryCommand}" Margin="0,0,8,8"/><Button Content="정상 종료 요청" Command="{Binding NormalCloseCommand}" Margin="0,0,8,8"/><Button Content="강제 종료 후 삭제…" Command="{Binding ForceCloseCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock Text="종료 작업은 사용 중인 파일 알림에 적용됩니다. 강제 종료 전 대상 앱과 파일을 다시 확인합니다." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel></Border>
   </Grid>
  </TabItem>
  <TabItem Header="Settings" Tag="&#xE115;" ToolTip="기록 보관, 센서 경고 기준과 백그라운드 동작을 관리하세요.">
   <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0"><Button Content="Save changes" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/></Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Background cleanup" Style="{StaticResource SectionTitle}"/><TextBlock Text="일시정지는 새로운 삭제 작업을 멈춥니다. 진행 중 작업은 Dashboard에서 취소할 수 있습니다." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Pause" Command="{Binding PauseCommand}" Margin="0,0,8,0"/><Button Content="Resume" Command="{Binding ResumeCommand}"/></StackPanel></Grid></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="Recovery cache" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="삭제 전 복구본을 보관할 RAM 한도를 설정합니다. 한도를 늘리면 현재 복구본을 유지합니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,18"/>
      <StackPanel Width="220" HorizontalAlignment="Left"><TextBlock Text="RAM limit (MiB)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CacheCapacityMiB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="Recovery cache RAM limit (MiB)"/></StackPanel>
      <TextBlock Text="1~16,384 MiB · 기본값 1,024 MiB (1 GiB)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
      <TextBlock Text="한도를 줄이면 오래된 복구본부터 즉시 제거되어 해당 항목은 복구할 수 없습니다." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,14,0,0"/>
      <TextBlock Text="정리·Preview·복구 작업이 없을 때 Save changes로 즉시 적용됩니다. 서비스 재시작은 필요하지 않습니다." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="History retention" Style="{StaticResource SectionTitle}"/><TextBlock Text="오래된 기록부터 정리합니다. 복구·진행 중 작업·미해결 알림 기록은 보존하므로 상한을 초과할 수 있습니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,18"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Retention (days)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="Retention (days)" Text="{Binding Settings.HistoryDays,ValidatesOnExceptions=True}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="History limit (MiB)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding HistoryMaxMiB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="이력 DB 보관 용량 MiB"/><TextBlock Text="10~102,400 MiB · 기본값 2,048 MiB" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
      </Grid>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="Interlocks" Style="{StaticResource SectionTitle}"/><TextBlock Text="CPU·RAM·디스크 상태가 기준을 벗어나면 정리를 차단합니다. 원인이 정상화된 뒤 복구 대기 시간을 적용합니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,18"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="RAM reserve (MiB)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MinimumAvailableRamMiB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="남겨둘 시스템 RAM MiB"/><TextBlock Text="1~1,048,576 MiB" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Trip delay (sec)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding InterlockTripSeconds,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="인터록 차단 대기 시간 초"/><TextBlock Text="0~3,600초 · 0은 즉시" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
       <StackPanel Grid.Column="4"><TextBlock Text="Recovery delay (sec)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding InterlockRecoverySeconds,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="인터록 복구 대기 시간 초"/><TextBlock Text="0~3,600초 · 기본값 60초" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
      </Grid>
      <CheckBox Content="리소스 정상화 후에도 수동 Reset까지 차단 유지" IsChecked="{Binding Settings.InterlockManualReset}" Margin="0,18,0,8"/>
      <TextBlock Text="RAM 부족·지정 앱 실행·감시 상태 이상은 즉시 차단합니다. Trip delay는 CPU 부하·온도·디스크 지연에 적용됩니다." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="차단할 앱 · 실행 파일 이름을 한 줄에 하나" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><TextBox Text="{Binding InterlockApps,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="정리를 차단할 앱 목록"/>
      <TextBlock Text="예: VideoEncoder.exe · 지정 앱이 실행 중이면 정리를 차단하며 앱을 종료하지 않습니다. 비워두면 앱 조건을 사용하지 않습니다." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}"/><TextBlock Text="새로 발견한 사용 중인 파일 알림의 표시 방법입니다. 표시를 줄여도 Alerts와 로그에는 계속 남습니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,18"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Locked-file delivery" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding NotificationModes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Settings.LockedFileNotificationMode}" AutomationProperties.Name="잠금 파일 알림 표시 방식"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Minimum interval (sec)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding LockedFileNotificationIntervalSeconds,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="신규 잠금 알림 최소 간격 초"/></StackPanel>
      </Grid>
      <TextBlock Text="0~86,400초 · 기본값 300초. 같은 조회에서 여러 건이 발견되면 대표 알림 한 건만 표시합니다. Save changes 후 적용되며 자동 확인·앱 종료는 수행하지 않습니다." Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Alert thresholds" Style="{StaticResource SectionTitle}"/><TextBlock Text="아래 자원 기준은 알림과 인터록에 사용합니다. 알림 기록에 필요한 지속 시간과 인터록 차단·복구 대기 시간은 각각 적용됩니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,18"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="CPU usage (%)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="CPU usage (%)" Text="{Binding Settings.CpuWarningPercent,ValidatesOnExceptions=True}"/><TextBlock Text="Disk latency (ms)" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/><TextBox AutomationProperties.Name="Disk latency (ms)" Text="{Binding Settings.DiskLatencyWarningMs,ValidatesOnExceptions=True}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="CPU temperature (℃)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="CPU temperature (℃)" Text="{Binding Settings.CpuTemperatureWarning,ValidatesOnExceptions=True}"/><TextBlock Text="Disk temperature (℃)" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/><TextBox AutomationProperties.Name="Disk temperature (℃)" Text="{Binding Settings.DiskTemperatureWarning,ValidatesOnExceptions=True}"/></StackPanel>
       <StackPanel Grid.Column="4"><TextBlock Text="이상 지속 시간 (초)" Style="{StaticResource FieldLabel}"/><TextBox AutomationProperties.Name="이상 지속 시간 (초)" Text="{Binding Settings.AnomalyDurationSeconds,ValidatesOnExceptions=True}"/></StackPanel>
      </Grid>
      <CheckBox Content="디스크 심각 알림 발생 시 자동 정리 중단" IsChecked="{Binding Settings.PauseOnHealthCritical}" Margin="0,20,0,0"/>
     </StackPanel></Border>
