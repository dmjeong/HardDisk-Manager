<Project>
  <PropertyGroup Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe' Or '$(IsTestProject)' == 'true'">
    <AppConfig>$(MSBuildThisFileDirectory)src\FrameworkApp.config</AppConfig>
  </PropertyGroup>
  <ItemGroup Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe' Or '$(IsTestProject)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)src\FrameworkApp.config" Link="App.config" />
  </ItemGroup>
  <!-- net48 does not reliably flatten RID native assets; the loader needs the x64 DLL at the executable base. -->
  <ItemGroup Condition="Exists('$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3/2.1.13/runtimes/win-x64/native/e_sqlite3.dll')">
    <Content Include="$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3/2.1.13/runtimes/win-x64/native/e_sqlite3.dll"
             Link="e_sqlite3.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
